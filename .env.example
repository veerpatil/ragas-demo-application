# Copy to .env and adjust as needed. All variables are optional.

# Provider: "ollama" (real local models) or "fake" (offline, deterministic)
RAG_LLM_PROVIDER=ollama

# Ollama endpoints
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OPENAI_BASE_URL=http://localhost:11434/v1

# Models
RAG_EMBED_MODEL=nomic-embed-text
RAG_GEN_MODEL=llama3.2:3b
RAG_JUDGE_MODEL=gemma4:12b

# Retrieval
RAG_TOP_K=4
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120

# Quality gates (a run fails if a mean metric drops below its threshold)
RAG_GATE_FAITHFULNESS=0.70
RAG_GATE_ANSWER_RELEVANCY=0.60
RAG_GATE_CONTEXT_PRECISION=0.60
RAG_GATE_CONTEXT_RECALL=0.60
